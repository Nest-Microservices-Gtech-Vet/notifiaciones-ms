generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NotificacionRecord {
  not_id       Int      @id @default(autoincrement())
  tipo         String // Ej: "Vacunacion", "Dsparacitacion interna", "Desparacitacion externa"
  descripcion  String?
  fecha_envio  DateTime
  destinatario String
  enviado      Boolean  @default(false)
  vacunaId     Int? // ← Referencia a la vacuna del otro microservicio
  empresaId   Int?
  createdBy    Int? // ID del usuario que creó el registro
  updatedBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
